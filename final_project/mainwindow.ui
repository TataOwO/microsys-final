   <!-- Operation Guide -->
   <widget class="QLabel" name="lblGuide">
    <property name="geometry">
     <rect>
      <x>20</x>
      <y>450</y>
      <width>710</width>
      <height>50</height>
     </rect>
    </property>
    <property name="font">
     <font>
      <pointsize>8</pointsize>
     </font>
    </property>
    <property name="text">
     <string>STANDBY: All LEDs ON steady. Press 1-4 to execute an item.
EXECUTING: Selected LED blinks. System locked until complete.
ALARM: All LEDs blink fast. Press U to dismiss and return to STANDBY.</string>
    </property>
    <property name="alignment">
     <set>Qt::AlignCenter</set>
    </property>
    <property name="styleSheet">
